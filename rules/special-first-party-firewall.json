[
    {
        "uuid": "64c0f201-4871-48cb-9681-5d64bcaa0701",
        "title": "Strict First-Party Mode",
        "description": "WARNING: This strict mode blocks every third-party-domain subresource while leaving top-level navigation alone. It can break logins, CDNs, APIs, embeds, payments, CAPTCHAs and other site functionality. Enable it only deliberately and disable it again when a site stops working.",
        "tag": "special-first-party-firewall",
        "pattern": {
            "allUrls": true,
            "origin": "third-party-domain"
        },
        "types": [
            "sub_frame",
            "script",
            "stylesheet",
            "image",
            "font",
            "media",
            "object",
            "object_subrequest",
            "imageset",
            "beacon",
            "ping",
            "speculative",
            "websocket",
            "xmlhttprequest",
            "web_manifest",
            "csp_report",
            "xml_dtd",
            "xslt",
            "other"
        ],
        "action": "block",
        "active": false
    }
]
