{
  "name": "requestcontrol",
  "license": "MPL-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "value": "git+https://github.com/HyperCriSiS/requestcontrol.git"
  },
  "config": {
    "ignore": "test/ coverage/ docs/ scripts/ .github/ .node-version eslint.config.js README* **/manual.wiki package*.json"
  },
  "scripts": {
    "start": "node scripts/web-ext.mjs run --bc --url about:debugging#addons",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "lint-build": "node scripts/lint-build.mjs",
    "copy-vendor": "node scripts/copy-vendor-assets.mjs",
    "build-manual": "node scripts/build-manual.mjs",
    "postinstall": "npm run copy-vendor",
    "prebuild": "npm run build-manual",
    "build": "node scripts/web-ext.mjs build --overwrite-dest --verbose",
    "deploy": "node scripts/web-ext.mjs sign --verbose",
    "audit": "node scripts/audit-dependencies.mjs",
    "lint": "eslint src test scripts && npm run lint:json && node scripts/web-ext.mjs lint",
    "lint:json": "node scripts/validate-json.mjs"
  },
  "dependencies": {
    "@ajusa/lit": "^1.1.0",
    "tldts-experimental": "^7.4.10"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "addons-linter": "^10.10.0",
    "eslint": "^10.9.1",
    "globals": "^17.7.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "web-ext": "^10.6.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "transform": {},
    "coverageDirectory": "./coverage/",
    "collectCoverage": true,
    "collectCoverageFrom": [
      "src/main/**/*"
    ],
    "coverageReporters": [
      "text-summary",
      "lcov"
    ]
  }
}
