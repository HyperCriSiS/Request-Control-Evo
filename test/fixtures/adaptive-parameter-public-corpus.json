      "basis": "Matomo documents mtm_* campaign parameters and compatible matomo_/pk_/piwik_ campaign prefixes as campaign tracking data."
    },
    "google-traffic-source": {
      "url": "https://support.google.com/analytics/answer/15612152?hl=en",
      "basis": "Google Analytics documents gclsrc alongside auto-tagging identifiers for Search Ads 360 traffic-source attribution."
    },
    "oauth-rfc6749": {
      "url": "https://datatracker.ietf.org/doc/rfc6749/",
      "basis": "OAuth 2.0 defines authorization-request parameters such as response_type, client_id, redirect_uri, scope and state."
    },
    "pkce-rfc7636": {
      "url": "https://datatracker.ietf.org/doc/rfc7636/",
      "basis": "PKCE defines code_verifier, code_challenge and code_challenge_method as protocol parameters."
    },
    "oidc-core": {
      "url": "https://openid.net/specs/openid-connect-core-1_0-final.html",
      "basis": "OpenID Connect defines nonce and authorization-request controls/hints including prompt, max_age, locale and login-related parameters."
    },
    "aws-s3-sigv4": {
      "url": "https://docs.aws.amazon.com/AmazonS3/latest/developerguide/sigv4-query-string-auth.html",
      "basis": "Amazon S3 Signature V4 uses X-Amz-* query parameters to authenticate presigned URLs."
    },
    "odata-query-options": {
      "url": "https://learn.microsoft.com/en-us/odata/concepts/queryoptions-overview",
      "basis": "OData system query options control filtering, selection, ordering, paging, expansion and search."
    }
  },
